  "Logitech G": {
    website: "https://www.logitechg.com/es-es",
    country: "Swiss",
  },
};

async function main() {
  for (const product of products) {
    const brandData = brandInfo[product.brand];

    await prisma.brands.upsert({
      where: { name: product.brand },
      update: {
        website: brandData.website,
        country: brandData.country,
      },
      create: {
        name: product.brand,
        website: brandData.website,
        country: brandData.country,
      },
    });

    const mouse = await prisma.mice.upsert({
      where: { model: product.model },
      update: {
        slug: product.slug,
        description: [
          `${product.brand} ${product.model}.`,
          `Sensor ${product.sensor} de hasta ${product.dpi} DPI.`,
          ...(product.weight_grams === null
            ? []
            : [`Peso: ${product.weight_grams} g.`]),
          `Conectividad: ${product.connectivity}.`,
        ].join(" "),
        status: true,
        brand: { connect: { name: product.brand } },
      },
      create: {
        model: product.model,
        slug: product.slug,
        description: [
          `${product.brand} ${product.model}.`,
          `Sensor ${product.sensor} de hasta ${product.dpi} DPI.`,
          ...(product.weight_grams === null
            ? []
            : [`Peso: ${product.weight_grams} g.`]),
          `Conectividad: ${product.connectivity}.`,
        ].join(" "),
        status: true,
        brand: { connect: { name: product.brand } },
      },
    });

    // El esquema actual solo persiste sensor, DPI, polling, switches y conectividad.
    // Peso, forma, agarres y popularidad no tienen columnas en mouse_specs.
    const specs = {
      sensor: product.sensor,
      dpi: product.dpi,
      polling_rate: product.polling_rate,
      switches: product.switches,
      connectivity: product.connectivity,
    };

    await prisma.mouse_specs.upsert({
      where: { mouse_id: mouse.mouse_id },
      update: specs,
      create: {
        mouse_id: mouse.mouse_id,
        ...specs,
      },
    });
  }

  console.log(`${products.length} modelos procesados correctamente`);
}

main()
  .catch((error) => {
    console.error(error);
    process.exitCode = 1;
  })
  .finally(async () => {
    await prisma.$disconnect();
  });
