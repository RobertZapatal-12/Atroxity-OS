const brandInfo: Record<string, { website: string; country: string }> = {
  Razer: { website: "https://www.razer.com", country: "Singaporean-American" },
  Logitech: { website: "https://www.logitechg.com", country: "Swiss" },
  Pulsar: { website: "https://www.pulsar.gg", country: "South Korean" },
  Zowie: { website: "https://zowie.benq.com", country: "Taiwanese" },
